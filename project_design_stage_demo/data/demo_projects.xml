            <field name="is_done">0</field>
        </record>

        <record id="demo_budget_villa_1" model="project.design.budget.line">
            <field name="project_id" ref="demo_project_villa_renovation"/>
            <field name="design_stage">concept</field>
            <field name="planned_amount">5000</field>
        </record>


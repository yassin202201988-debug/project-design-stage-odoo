<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- مشروع 1: Concept -->
        <record id="demo_project_villa_renovation" model="project.project">
            <field name="name">Villa Renovation</field>
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="design_stage">concept</field>
        </record>

        <record id="demo_checklist_villa_1" model="project.design.checklist.item">
            <field name="project_id" ref="demo_project_villa_renovation"/>

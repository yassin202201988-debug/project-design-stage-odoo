<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_design_stage" model="ir.module.category">
        <field name="name">Design Stage</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_design_user" model="res.groups">
        <field name="name">Designer</field>
        <field name="category_id" ref="module_category_design_stage"/>
    </record>

    <record id="group_design_manager" model="res.groups">
        <field name="name">Design Manager</field>
        <field name="category_id" ref="module_category_design_stage"/>
        <field name="implied_ids" eval="[(4, ref('group_design_user'))]"/>
    </record>
</odoo>